# Copy this file to .env and fill in real values.

# Server
ADMIN_PASSWORD=your-admin-password
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://user:password@mysql.example.com:3306/database

# Image API
API_BASE_URL=https://api.example.com/v1
API_KEY=your-api-key
API_MODEL=gpt-image-1

# Optional
# PORT=8787
# IMAGE_PROXY_BODY_LIMIT_MB=6
# MYSQL_CONNECTION_LIMIT=4

# Optional, only for local MySQL store tests
# MYSQL_TEST_DATABASE_URL=mysql://user:password@127.0.0.1:3306/test_database
